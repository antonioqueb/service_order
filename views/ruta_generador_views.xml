<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="action_ruta_generador" model="ir.actions.act_window">
    <field name="name">Catálogo de Rutas</field>
    <field name="res_model">ruta.generador</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smart_action">
        Registra las rutas formales por generador: origen, destino, distancia
        y tiempo estimado. Es un catálogo de referencia, independiente de las
        órdenes de servicio, manifiestos y planeación logística.
      </p>
    </field>
  </record>

  <record id="view_ruta_generador_list" model="ir.ui.view">
    <field name="name">ruta.generador.list</field>
    <field name="model">ruta.generador</field>
    <field name="arch" type="xml">
      <list default_order="generador_id, name">
        <field name="name"/>
        <field name="generador_id"/>
        <field name="origen"/>
        <field name="destino"/>
        <field name="distancia_km" optional="show"/>
        <field name="tiempo_estimado" optional="show"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_ruta_generador_form" model="ir.ui.view">
    <field name="name">ruta.generador.form</field>
    <field name="model">ruta.generador</field>
    <field name="arch" type="xml">
      <form string="Ruta por Generador">
        <sheet>
          <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Ej: Ruta Planta Norte - Confinamiento Central"/></h1>
          </div>
          <group>
            <group string="Generador">
              <field name="generador_id"/>
              <field name="active" invisible="1"/>
            </group>
            <group string="Recorrido">
              <field name="origen"/>
              <field name="destino"/>
              <field name="distancia_km"/>
              <field name="tiempo_estimado"/>
            </group>
          </group>
          <group>
            <field name="observaciones"/>
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ruta_generador_search" model="ir.ui.view">
    <field name="name">ruta.generador.search</field>
    <field name="model">ruta.generador</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="generador_id"/>
        <field name="origen"/>
        <field name="destino"/>
        <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
        <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
        <separator/>
        <filter string="Generador" name="group_generador" context="{'group_by': 'generador_id'}"/>
      </search>
    </field>
  </record>

  <menuitem id="menu_ruta_generador_root"
            name="Rutas"
            sequence="60"/>

  <menuitem id="menu_ruta_generador"
            name="Catálogo de Rutas"
            parent="menu_ruta_generador_root"
            action="action_ruta_generador"
            sequence="10"/>

</odoo>
